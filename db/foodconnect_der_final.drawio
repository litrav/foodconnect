ray></mxGeometry></mxCell><mxCell id="E10_c0" value="N" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="289.0" y="202.0" width="20" height="18" as="geometry"/></mxCell><mxCell id="E10_c1" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="421.0" y="329.0" width="20" height="18" as="geometry"/></mxCell><mxCell id="legenda" value="&lt;b&gt;Notação&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;PK&lt;/u&gt;&lt;/b&gt; = chave primária (negrito e sublinhado)&lt;br&gt;FKn = chave estrangeira&lt;br&gt;&lt;b&gt;Negrito&lt;/b&gt; = obrigatório (NOT NULL) · normal = opcional&lt;br&gt;Seta → tabela referenciada (lado 1) · N = lado da FK&lt;br&gt;&lt;br&gt;&lt;b&gt;Do conceitual ao lógico&lt;/b&gt;&lt;br&gt;usuário × estabelecimento (1:1) → FK UNIQUE&lt;br&gt;usuário × instituição (1:1) → FK UNIQUE&lt;br&gt;excedente × instituição (N:N) → DOACAO&lt;br&gt;endereço → tabela própria ENDERECO (3FN)&lt;br&gt;Verde = novo no CP3 (análise preditiva)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Arial;fillColor=#FAFAFA;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1010" y="640" width="370" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>